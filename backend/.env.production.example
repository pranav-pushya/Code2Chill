# Code2Chill Production Environment Configuration
# Copy this file to .env.production on the production host and fill in all values.

# 1. Database Configuration (Required)
# Generate a strong, random password: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=code2chill
POSTGRES_USER=code2chill

# 2. Public Site Domain & HTTPS (Required)
# Canonical origin used for metadata, social preview cards, and email link callbacks.
PUBLIC_SITE_URL=https://code2chill.chitkara.edu.in
# Domain name for Caddy automatic HTTPS certificates (or :80 if behind external cloud load balancer).
SERVER_NAME=code2chill.chitkara.edu.in
PROD_HTTP_PORT=80
PROD_HTTPS_PORT=443

# 3. Recruitment Verification Email (SMTP over TLS - Required for local recruitment cycles)
RECRUITMENT_SMTP_HOST=smtp.gmail.com
RECRUITMENT_SMTP_PORT=465
RECRUITMENT_MAIL_FROM=code2chill@chitkara.edu.in
RECRUITMENT_SMTP_USER=code2chill@chitkara.edu.in
RECRUITMENT_SMTP_PASSWORD=

# 4. Operations & Backup Settings
BACKUP_RETENTION_DAYS=14
