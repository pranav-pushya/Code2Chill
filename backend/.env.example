# Set a unique password before starting the database.
POSTGRES_PASSWORD=
DB_HOST_PORT=55432
# Optional for an existing external database. Use the psycopg driver.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/database
# Optional public HTTPS origin for canonical links behind a reverse proxy.
# Set this in the staging Compose environment file or the API process environment.
# PUBLIC_SITE_URL=https://club.example.org

# Local recruitment uses SMTP over TLS. Configure these before opening a local cycle.
RECRUITMENT_SMTP_HOST=
RECRUITMENT_SMTP_PORT=465
RECRUITMENT_MAIL_FROM=
RECRUITMENT_SMTP_USER=
RECRUITMENT_SMTP_PASSWORD=
